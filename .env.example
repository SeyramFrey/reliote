# Copie ce fichier vers .env.local et remplis les valeurs.
# En local vs Vercel : mêmes noms de variables, valeurs différentes selon l'environnement.

# === Supabase ===
# Sur Supabase Cloud : Dashboard → Settings → API
# Sur self-hosted    : les valeurs sont dans supabase/.env

# Public (envoyé au navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Serveur uniquement — bypass RLS. JAMAIS envoyé au browser.
# Sur Vercel : à cocher "Sensitive" pour masquer la valeur dans l'UI.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# URL du site pour les callbacks auth (reset password, magic links, OAuth)
# et les liens dans les e-mails transactionnels.
# En local : http://localhost:3000
# En prod  : https://<ton-projet>.vercel.app
SITE_URL=http://localhost:3000

# === Resend (e-mails transactionnels) ===
# https://resend.com → API Keys. Sans RESEND_API_KEY, l'app tourne mais
# n'envoie aucun e-mail (no-op silencieux) — pratique en local.
RESEND_API_KEY=<re_... clé API Resend>
# Expéditeur : doit utiliser un domaine vérifié dans Resend.
RESEND_FROM=Reliote <notifications@ton-domaine.com>
# Adresse admin mise en copie des e-mails de RDV (optionnel).
RELIOTE_ADMIN_EMAIL=admin@ton-domaine.com

# === CKEditor 5 (éditeur des pages légales, admin) ===
# CKEditor 5 est en DOUBLE LICENCE : GPL-2.0+ ou commerciale.
# Reliote étant un produit privé, la voie GPL n'est pas ouverte — elle
# obligerait à publier Reliote sous GPL. Il faut donc une clé obtenue sur
# https://portal.ckeditor.com (leur offre gratuite couvre un usage de
# back-office). Sans clé valide, l'éditeur refuse de se charger en production.
# En local, la valeur de repli 'GPL' suffit pour développer.
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=<clé CKEditor, ou GPL en local>
