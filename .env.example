# Copie ce fichier vers .env.local et remplis les valeurs.
# En local vs Vercel : mêmes noms de variables, valeurs différentes selon l'environnement.

# === Supabase ===
# Sur Supabase Cloud : Dashboard → Settings → API
# Sur self-hosted    : les valeurs sont dans supabase/.env

# Public (envoyé au navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Serveur uniquement — bypass RLS. JAMAIS envoyé au browser.
# Sur Vercel : à cocher "Sensitive" pour masquer la valeur dans l'UI.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# URL du site pour les callbacks auth (reset password, magic links, OAuth).
# En local : http://localhost:3000
# En prod  : https://<ton-projet>.vercel.app
SITE_URL=http://localhost:3000
