# === URLs ===
SITE_URL=http://localhost:3000
KONG_HTTP_PORT=54321
STUDIO_PORT=54323

# Supabase Realtime (messagerie) — 64+ caractères ; générer avec : openssl rand -hex 32
REALTIME_SECRET_KEY_BASE=dev-realtime-secret-key-base-change-me-0123456789abcdef0123456789abcdef

# === Production (VPS) — voir docs/VPS-DEPLOYMENT.md §2 à §4 ===
# Laisser vides/commentées en dev local.
# API_EXTERNAL_URL=https://api.reliote.com
# GOTRUE_URI_ALLOW_LIST=https://reliote.com/**,https://www.reliote.com/**
# GOTRUE_MAILER_AUTOCONFIRM=false
# GOTRUE_PASSWORD_MIN_LENGTH=8
# GOTRUE_SMTP_HOST=smtp.resend.com
# GOTRUE_SMTP_PORT=465
# GOTRUE_SMTP_USER=resend
# GOTRUE_SMTP_PASS=<clé Resend>
# GOTRUE_SMTP_ADMIN_EMAIL=notifications@reliote.com
# Chiffrement des secrets de tenant Realtime — exactement 16 caractères (openssl rand -hex 8)
# REALTIME_DB_ENC_KEY=
# Adresse d'écoute des ports Docker (Postgres, Kong). Ne jamais mettre 0.0.0.0 sur le VPS.
# BIND_ADDR=127.0.0.1
