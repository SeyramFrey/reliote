# === Keys ===
# Dev-only JWTs signed with the JWT_SECRET above. Regenerate for prod via supabase docs.
# Header: {"alg":"HS256","typ":"JWT"}
# Payload anon: {"role":"anon","iss":"supabase-demo","iat":1700000000,"exp":2000000000}
# Payload service_role: {"role":"service_role","iss":"supabase-demo","iat":1700000000,"exp":2000000000}
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjAwMDAwMDAwMH0.wAA3HvPBHTcOSKf1NGlMpbY_EhrRqiV4hrMq9vAKAJM
